# =============================================================================
# Text Translator — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your local values.
# Never commit .env.local to the repository — it contains secrets.
#
# Astro loads env files in this order (later overrides earlier):
#   1. .env              (committed, shared defaults)
#   2. .env.local        (local secrets, gitignored)
#   3. .env.development  (dev-specific overrides)
#   4. .env.production   (prod-specific overrides)
#   5. .env.test         (test-specific overrides)
#
# See: https://docs.astro.build/en/guides/environment-variables/
# =============================================================================

# ---- Paths ----
# These are typically different on each developer's machine.
# Override them in .env.local with absolute or relative paths.

# Directory containing original (*_orig.txt) files
# ORIGINALS_DIR=./originals

# Directory containing translation (*.txt) files
# TRANSLATIONS_DIR=./translations

# ---- Database ----
# Path to the SQLite database file (relative paths are resolved from project root)
# DB_PATH=./data/translator.db

# ---- Proxy ----
# HTTP/HTTPS proxy server for API requests (e.g. http://127.0.0.1:7890)
# PROXY_SERVER=

# ---- Secrets (always set in .env.local, never in .env) ----
# OPENROUTER_API_KEY=sk-or-v1-...